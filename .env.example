# Copy this file to .env and put in your own key. Never commit .env.
# Without a key the service still runs: every message goes to a human
# with the reason "classifier unavailable". That is the safe fallback.

# OpenRouter key (one key): https://openrouter.ai/keys
OPENAI_COMPAT_API_KEY=

# Model and API address (defaults shown)
TRIAGE_MODEL=deepseek/deepseek-v4.1-flash
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1

# Optional
# TRIAGE_REASONING=off            # or "low"
# TRIAGE_DATA_COLLECTION=deny     # or "allow" if no provider is available
